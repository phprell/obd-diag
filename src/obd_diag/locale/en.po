msgstr[0] "{n} warm-up"
msgstr[1] "{n} warm-ups"

#: src/obd_diag/services/used_car.py
msgid "Das Fahrzeug meldet nicht, wie lange das Löschen der Fehlercodes her ist (PID 30, 31, 4E); ob kürzlich gelöscht wurde, lässt sich nicht sagen."
msgstr "The vehicle does not report how long ago the trouble codes were cleared (PID 30, 31, 4E); whether they were cleared recently cannot be told."


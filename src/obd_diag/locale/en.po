msgstr "Record (CSV)"

#: src/obd_diag/ui/qml/LiveView.qml
msgid "Jede Runde sofort in eine neue CSV-Datei schreiben"
msgstr "Write every round straight into a new CSV file"

#: src/obd_diag/ui/qml/LiveView.qml
msgid "Warnschwellen …"
msgstr "Warning thresholds …"

#: src/obd_diag/ui/qml/LiveView.qml
msgid "Bordspannung %1"
msgstr "Battery voltage %1"

#: src/obd_diag/ui/qml/LiveView.qml
msgid "1 Runde"
msgstr "1 round"

#: src/obd_diag/ui/qml/LiveView.qml

msgstr[0] "Consistent with this, {n} readiness test is incomplete: {names}."
msgstr[1] "Consistent with this, {n} readiness tests are incomplete: {names}."

#: src/obd_diag/services/used_car.py
msgid "{n} Readiness-Test nicht abgeschlossen: {names}. Das kann auch an den Fahrbedingungen liegen."
msgid_plural "{n} Readiness-Tests nicht abgeschlossen: {names}. Das kann auch an den Fahrbedingungen liegen."
msgstr[0] "{n} readiness test incomplete: {names}. This can also be due to driving conditions."
msgstr[1] "{n} readiness tests incomplete: {names}. This can also be due to driving conditions."

#: src/obd_diag/services/used_car.py
msgid "Keine permanenten Fehlercodes gemeldet."
msgstr "No permanent trouble codes reported."

#: src/obd_diag/services/used_car.py
